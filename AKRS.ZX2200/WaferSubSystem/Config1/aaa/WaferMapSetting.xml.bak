<WaferMap>
  <WM_FORMAT>
    <PreserveDegree>False</PreserveDegree>
    <Degree>90</Degree>
  </WM_FORMAT>
  <WaferMapFilesRootDir>D:\晶圆图文件</WaferMapFilesRootDir>
  <WrapErrorProof>False</WrapErrorProof>
  <AdditionalPathSeeker>False</AdditionalPathSeeker>
  <ResetOnConflict>False</ResetOnConflict>
  <MinRefPointCount>1</MinRefPointCount>
  <SetChipType Desc="popup menu">True</SetChipType>
  <AddReferencePoint Desc="popup menu">True</AddReferencePoint>
  <DeleteReferencePoint Desc="popup menu">True</DeleteReferencePoint>
  <PrintPathDetail>True</PrintPathDetail>
  <AutoLoadLastWaferMapFile>True</AutoLoadLastWaferMapFile>
  <SyncUpdateUI>False</SyncUpdateUI>
  <MultiStrategies Desc="Is multiply strategies enabled">False</MultiStrategies>
  <ChipTypeLocked>False</ChipTypeLocked>
  <FileSearch>
    <FileNameType>Full</FileNameType>
    <FileSelectionMode>ListAll</FileSelectionMode>
    <SubDirDepth>-1</SubDirDepth>
    <FirstCharIndex>0</FirstCharIndex>
    <KeyStringLength>0</KeyStringLength>
    <FileNameExtension>.txt</FileNameExtension>
  </FileSearch>
  <DefaultSubstitution Desc="The default substitution for nested null chips">*</DefaultSubstitution>
  <ShowChipTypeIntegerValue>True</ShowChipTypeIntegerValue>
  <GapMode>Auto</GapMode>
  <PathKind>DetailedPath</PathKind>
  <UserCoordinateSystemType Enum="Text">0</UserCoordinateSystemType>
  <RulerVisible>True</RulerVisible>
  <CheckNestedNullChips>False</CheckNestedNullChips>
  <FirstPointInitialPosition>PreviousSetting</FirstPointInitialPosition>
  <AutoFirstPointOnUserDirectionChanged>False</AutoFirstPointOnUserDirectionChanged>
  <ShowAlertIfRowOrColumnCountChanged>True</ShowAlertIfRowOrColumnCountChanged>
  <WaferBoundaryVisible>False</WaferBoundaryVisible>
  <ChipAppearAsSquare>False</ChipAppearAsSquare>
  <LoadUpdatesDirFileFirst>False</LoadUpdatesDirFileFirst>
  <AlertWhenFileNameDuplicating>True</AlertWhenFileNameDuplicating>
  <DoNotShowDialogBox_FileInfo>False</DoNotShowDialogBox_FileInfo>
  <PrintPositionAndCoordinates>True</PrintPositionAndCoordinates>
  <WaferMapControlLayout>EntiretyFirst</WaferMapControlLayout>
  <ApplyFileSepcifiedUserCoordinateSystemFirst>True</ApplyFileSepcifiedUserCoordinateSystemFirst>
</WaferMap>